---
services:
  logos-node:
    container_name: '{{ logos_node_cont_name }}'
    image: '{{ logos_node_cont_image }}'
    deploy:
      resources:
        limits:
          cpus: '{{ logos_node_cpu_limit | float }}'
          memory: '{{ logos_node_mem_limit }}M'
    volumes:
      - '{{ logos_node_cont_vol }}/entrypoint.sh:/opt/entrypoint.sh:Z'
      - '{{ logos_node_cont_vol }}/persistence:/var/lib/logos/persistence'
{% if logos_node_delivery_enabled | bool %}
      - '{{ logos_node_conf_path }}/waku_config.json:/conf/waku_config.json:ro'
{% if logos_node_delivery_rln_enabled | bool %}
      - '{{ logos_node_conf_path }}/rln_presets.json:/conf/rln_presets.json:ro'
{% endif %}
{% if logos_node_delivery_websocket_secure_enabled %}
      - '{{ logos_node_delivery_websocket_ssl_dir }}:/etc/letsencrypt:ro'
{% endif %}
{% endif %}
{% if logos_node_storage_enabled | bool %}
{% if logos_node_storage_role | default('mp') == 'rs' %}
      - '{{ logos_node_conf_path }}/mix-pool.json:/conf/mix-pool.json:ro'
{% endif %}
      - '{{ logos_node_conf_path }}/storage_key:/conf/storage_key:ro'
      - '{{ logos_node_cont_vol }}/data:{{ logos_node_storage_data_dir }}'
      - '{{ logos_node_storage_content_dir }}:/content'
{% endif %}
{% if logos_node_blockchain_enabled | bool %}
      - '{{ logos_node_conf_path }}/node_config.yaml:/conf/node_config.yaml:ro'
      - '{{ logos_node_cont_vol }}/data:/app/db'
      - '{{ logos_node_cont_vol }}/state:/app/state'
{% endif %}
    ports:
{% if logos_node_delivery_enabled | bool %}
      - '{{ logos_node_delivery_p2p_tcp_port }}:{{ logos_node_delivery_p2p_tcp_port }}/tcp'
      - '{{ logos_node_delivery_p2p_udp_port }}:{{ logos_node_delivery_p2p_udp_port }}/udp'
      - '{{ logos_node_delivery_discv5_udp_port }}:{{ logos_node_delivery_discv5_udp_port }}/udp'
{% if logos_node_delivery_kad_discovery_plugin_enabled | bool %}
      - '{{ logos_node_delivery_kad_discovery_plugin_p2p_tcp_port }}:{{ logos_node_delivery_kad_discovery_plugin_p2p_tcp_port }}/tcp'
{% endif %}
{% if logos_node_delivery_websocket_enabled %}
      - '{{ logos_node_delivery_websocket_port }}:{{ logos_node_delivery_websocket_port }}/tcp'
{% endif %}
{% endif %}
{% if logos_node_storage_enabled | bool %}
      - '{{ logos_node_storage_tcp_port }}:{{ logos_node_storage_tcp_port }}/tcp'
{% if logos_node_storage_api_enabled | bool %}
      - '127.0.0.1:{{ logos_node_storage_api_port }}:{{ logos_node_storage_api_port }}/tcp'
{% endif %}
{% endif %}
{% if logos_node_blockchain_enabled | bool %}
      - '{{ logos_node_blockchain_swarm_port }}:{{ logos_node_blockchain_swarm_port }}/udp'
      - '{{ logos_node_blockchain_blend_port }}:{{ logos_node_blockchain_blend_port }}/udp'
      - '{{ logos_node_blockchain_api_port }}:{{ logos_node_blockchain_api_port }}/tcp'
{% endif %}
{% if logos_node_metrics_enabled | bool %}
      - '{{ logos_node_metrics_port }}:{{ logos_node_metrics_port }}/tcp'
{% endif %}
    labels:
      com.centurylinklabs.watchtower.enable: '{{ logos_node_watchtower_enabled | to_json }}'
    environment:
{% if logos_node_delivery_enabled | bool %}
      STORE_DB_URL: '{{ logos_node_delivery_store_db_url }}'
{% if logos_node_delivery_kad_discovery_plugin_enabled | bool %}
      LIBP2P_MODULE_CONFIG: '/conf/libp2p_config.json'
{% endif %}
{% if logos_node_delivery_rln_enabled | bool %}
      LOGOS_DELIVERY_RLN_PRESETS: '/conf/rln_presets.json'
      LEZ_RLN_SEQUENCER: '{{ logos_node_delivery_rln_sequencer_url }}'
{% endif %}
{% endif %}
{% if logos_node_storage_enabled | bool %}
      STORAGE_NAT: '{{ logos_node_storage_nat }}'
      STORAGE_NET_PRIVKEY: '/conf/storage_key'
{% if logos_node_storage_no_bootstrap | bool %}
      STORAGE_NO_BOOTSTRAP_NODE: 'true'
{% elif logos_node_storage_bootstrap_nodes | length > 0 %}
      STORAGE_BOOTSTRAP_NODE: '{{ logos_node_storage_bootstrap_nodes | join(";") }}'
{% endif %}
{% if logos_node_storage_dht_mix_proxy | default([]) | length > 0 %}
      STORAGE_DHT_MIX_PROXY: '{{ logos_node_storage_dht_mix_proxy | join(";") }}'
{% endif %}
{% if logos_node_storage_role | default('mp') == 'rs' %}
      STORAGE_MIX_POOL: '/conf/mix-pool.json'
{% endif %}
{% if logos_node_storage_api_enabled | bool %}
      STORAGE_API_BINDADDR: '{{ logos_node_storage_api_bindaddr }}'
      STORAGE_API_PORT: '{{ logos_node_storage_api_port }}'
{% endif %}
{% endif %}
{% if logos_node_blockchain_enabled | bool %}
      LOGOS_BLOCKCHAIN_DEPLOYMENT: '{{ logos_node_blockchain_deployment }}'
      LOGOS_BLOCKCHAIN_CONFIG_PATH: '/conf/node_config.yaml'
{% endif %}
    healthcheck:
{% if logos_node_blockchain_enabled | bool %}
      test: ["CMD-SHELL", "curl -sf http://localhost:{{ logos_node_blockchain_api_port }}/cryptarchia/info || exit 1"]
{% elif logos_node_storage_enabled | bool %}
      test: ["CMD-SHELL", "logosctl status || exit 1"]
{% elif logos_node_delivery_enabled | bool %}
      test: ["CMD-SHELL", "logosctl status || exit 1"]
{% endif %}
      interval: 10s
      timeout: 5s
      retries: 18
      start_period: 30s
    entrypoint: /opt/entrypoint.sh
    restart: always
    stop_grace_period: 30s

{% if logos_node_blockchain_enabled %}
  otel-collector:
    image: '{{ logos_otel_cont_image }}'
    command: ["--config=/etc/otel-config.yml"]
    container_name: '{{ logos_otel_cont_name }}'
    volumes:
      - '{{ logos_node_conf_path }}/otel-config.yml:/etc/otel-config.yml'
    ports:
      - {{ logos_otel_exposed_port }}:{{ logos_otel_exposed_port }}
      - {{ logos_otel_exporter_port }}:{{ logos_otel_exporter_port }}
      - {{ logos_otel_rpc_receiver_port }}:{{ logos_otel_rpc_receiver_port }}
      - {{ logos_otel_http_receiver_port }}:{{ logos_otel_http_receiver_port }}
      - {{ logos_otel_healthcheck_port }}:{{ logos_otel_healthcheck_port }}
{% endif %}