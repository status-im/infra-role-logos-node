#!/usr/bin/env bash
set -e

logoscore -D -m ./modules &
DAEMON_PID=$!

until logoscore status > /dev/null 2>&1; do
  sleep 1
done

{% for module in logos_node_modules %}
logoscore load-module {{ module }}
{% endfor %}

{% for cmd in logos_node_module_calls %}
logoscore call {{ cmd }}
{% endfor %}

wait $DAEMON_PID